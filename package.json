{
  "name": "harness-auto-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bash .agents/checks.sh",
    "spec:new": "node .agents/scripts/new-spec.mjs",
    "test:harness": "node --test .agents/scripts/harness.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/changelog-ko.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "2.11.10"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
