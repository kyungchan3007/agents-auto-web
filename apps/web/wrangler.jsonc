// 사이트 Worker 설정 — Cloudflare Workers Builds 가 배포 (작업 0189 · 0190)
//   빌드: npx turbo run build --filter=@hav/web (저장소 맨 위에서) → apps/web/out
//   배포: npx wrangler deploy --config apps/web/wrangler.jsonc
//   미리보기(브랜치): npx wrangler versions upload --config apps/web/wrangler.jsonc
//   평일 다시 만들기: 배포 후크(daily-rebuild · main) — GitHub Secrets · API Worker 의 PAGES_DEPLOY_HOOK
// API Worker 설정은 apps/api/wrangler.jsonc · 옛 Pages(tripfx) 설정은 2026-11-17 프로젝트 삭제와 함께 지움 (작업 0190)
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // 대시보드 Worker 이름과 같아야 함 (다르면 Workers Builds 가 경고하고 CI 이름으로 덮어씀)
  "name": "agents-auto-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    // Next 정적 내보내기: /currencies → currencies.html · 없는 주소 → 404.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // worker/routes.ts 와 같아야 함 (routes.test.ts 가 검사)
    "run_worker_first": [
      "/",
      "/currencies",
      "/currencies/*",
      "/prices",
      "/calc",
      "/log",
      "/about",
      "/geo",
      "/how",
      "/robots.txt",
      "/sitemap.xml",
      "/bff/*"
    ]
  },
  // /bff/* 가 API Worker 를 바로 부름 (인터넷을 거치지 않음)
  "services": [{ "binding": "API", "service": "tripfx-api" }],
  // 페이지 방문 집계 (geo_hits · 작업 0129) · 표는 apps/api 마이그레이션이 만듦
  "d1_databases": [{ "binding": "DB", "database_name": "hav-db", "database_id": "eccde06e-211e-4eb0-95e5-c0c30f8ad278" }],
  // 플랩 주소 — 설정이 원본 (대시보드에서 붙인 사용자 지정 도메인과 같게 · 작업 0190)
  "routes": [
    { "pattern": "flapfx.com", "custom_domain": true },
    { "pattern": "www.flapfx.com", "custom_domain": true },
    // 어드민(작업실 · GEO 측정) — 같은 Worker 가 주소로 나눔 (worker/host.ts · 작업 0302)
    { "pattern": "admin.flapfx.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "upload_source_maps": true
}
