# 로컬 개발용 비밀값 — 이 파일을 .dev.vars 로 복사해 값 채우기 (.dev.vars 는 커밋 금지)
# 한국수출입은행 Open API 인증키 (없으면 Frankfurter 예비로 수집)
KOREAEXIM_KEY=
# 관리용 수집 API 토큰 (POST /fx/collect)
ADMIN_TOKEN=
# 공공데이터포털 인증키 — 관세청 과세환율 (없으면 과세환율 수집을 건너뜀)
#   발급: https://www.data.go.kr/data/15101230/openapi.do → 로그인 → "활용신청" (자동 승인) → 마이페이지에서 일반 인증키 복사
KCS_KEY=
# KOSIS(통계청) 공유서비스 OpenAPI 인증키 — 소비자물가 여행 품목 (없으면 KOSIS 수집을 건너뜀)
#   발급: https://kosis.kr/openapi/ → 회원가입 → 로그인 → "활용신청" (자동 발급 · 기간 만료 있음, 연장 가능)
KOSIS_KEY=
# 한국은행 ECOS OpenAPI 인증키 — 수입물가지수 (없으면 ECOS 수집을 건너뜀)
#   발급: https://ecos.bok.or.kr/api/ → 회원가입 → 로그인 → "인증키 신청" (이용기간 2년 · 연장 가능) · 화면에 "한국은행 ECOS" 출처 표시 의무
ECOS_KEY=
